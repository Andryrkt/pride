{
  "name": "@pride/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "echo 'drizzle: pas de g\u00e9n\u00e9ration de client n\u00e9cessaire'",
    "migrate:new": "drizzle-kit generate",
    "migrate:deploy": "tsx scripts/migrate.ts",
    "migrate:dev": "drizzle-kit generate && tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@pride/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "better-auth": "1.3.34",
    "drizzle-kit": "0.31.11",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "esbuild": "0.25.10"
  }
}
