# ---- Base de données (docker compose up -d) ----
DATABASE_URL=postgresql://pride:pride@localhost:5432/pride?schema=public

# ---- Authentification ----
# Générez une valeur : openssl rand -base64 32
BETTER_AUTH_SECRET=changez-moi-avec-une-longue-valeur-aleatoire
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stockage des fichiers (MinIO en local, S3 / R2 en production) ----
# Laissez S3_ENDPOINT vide pour stocker les fichiers sur le disque (dossier ./uploads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pride
S3_ACCESS_KEY=pride
S3_SECRET_KEY=pride-secret

# ---- E-mails (Mailpit en local : http://localhost:8025) ----
# Laissez SMTP_HOST vide pour afficher les e-mails dans la console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PRIDe <no-reply@pride.mg>"
MAIL_ASSOCIATION=association4pride@gmail.com

# ---- Paiements mobile money ----
# simulation : les paiements réussissent immédiatement (développement)
# reel       : appelle les API MVola / Orange Money / Airtel Money (à brancher)
PAYMENTS_MODE=simulation

# ---- Production uniquement (docker-compose.prod.yml) ----
DOMAIN=pride.mg
POSTGRES_USER=pride
POSTGRES_PASSWORD=changez-moi
